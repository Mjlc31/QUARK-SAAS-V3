{
  "id": "enriquecimento-001",
  "name": "Enriquecimento de Leads (CNPJ)",
  "nodes": [
    {
      "parameters": {
        "path": "lead-created",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ 'https://brasilapi.com.br/api/cnpj/v1/' + $json.body.cnpj }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "http-brasilapi",
      "name": "Consultar BrasilAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?id=eq.{{ $('Webhook Lead').item.json.body.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_KEY }}" },
            { "name": "Authorization", "value": "Bearer ={{ $env.SUPABASE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"razao_social\": \"{{ $json.razao_social }}\",\n  \"nome_fantasia\": \"{{ $json.nome_fantasia }}\",\n  \"cep\": \"{{ $json.cep }}\"\n}",
        "options": {}
      },
      "id": "update-supabase",
      "name": "Atualizar Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Webhook Lead": {
      "main": [
        [
          { "node": "Consultar BrasilAPI", "type": "main", "index": 0 }
        ]
      ]
    },
    "Consultar BrasilAPI": {
      "main": [
        [
          { "node": "Atualizar Supabase", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}
